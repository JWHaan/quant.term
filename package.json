{
  "name": "quant-term",
  "private": true,
  "version": "0.1.0",
  "description": "A crypto market intelligence terminal with deterministic strategy replay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWHaan/quant.term.git"
  },
  "homepage": "https://quant-term.vercel.app",
  "bugs": {
    "url": "https://github.com/JWHaan/quant.term/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc && vite build",
    "postbuild": "node scripts/verify-sites-build.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "shot": "node scripts/driver.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "wasm:build": "./scripts/build-wasm.sh",
    "wasm:check": "./scripts/check-wasm.sh",
    "check": "npm run lint && npm run type-check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "minimatch": "^11.0.7",
    "zod": "^4.6.7"
  }
}
